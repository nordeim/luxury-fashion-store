# Schema-relative SQLite URL — resolves against the prisma/ anchor, landing
# the database at <repoRoot>/db/custom.db. `npm run db:setup` creates it.
DATABASE_URL="file:../db/custom.db"

# Session-cookie HMAC secret (REQUIRED in production).
# Generate: openssl rand -base64 32
AUTH_SECRET=""

# Absolute origin used by metadata (canonical/og:url) and sitemap.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# H-35 (session-6): set to 1 ONLY behind a reverse proxy you trust. It makes
# the rate limiter identify clients by the proxy-overwritten x-forwarded-for
# hop; without it every caller shares one "local" bucket. The proxy must
# OVERWRITE (not append) the header.
TRUST_PROXY=""
