# deps
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dev.log
/server.log

# env — never commit real secrets
.env
.env.local
.env.production

# database — the SQLite files live at repo-root db/ (gitignored)
/db/*.db
/db/*.db-journal
/db/e2e.db*

# testing
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/e2e/.auth/
coverage/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# E2E runtime artifacts (regenerated by global-setup / specs every run)
/db/*.sql
/tests/e2e/*.sql
